# Convenience entry points. The canonical flow is still XX_RUN_FROM_SNAPSHOT.sh.
SHELLCHECK ?= vendor/shellcheck
SKOPEO     ?= ./skopeo
POLICY     := ci/containers-policy.json

.PHONY: help lint vendor vendor-tools run verify teardown

help:
	@echo "make lint         bash -n + shellcheck + python compile (no lab needed)"
	@echo "make vendor       fetch the two vendored images (needs internet, once)"
	@echo "make vendor-tools fetch shellcheck into vendor/"
	@echo "make run          revert to PostStack_Ready and run 03-12 (needs sudo)"
	@echo "make verify       independent read-only verification of the running lab"
	@echo "make teardown     destroy the lab (requires --yes; see 99_teardown.sh)"

lint:
	@./ci/lint.sh

vendor-tools:
	@mkdir -p vendor
	curl -fsSL https://github.com/koalaman/shellcheck/releases/download/v0.10.0/shellcheck-v0.10.0.linux.x86_64.tar.xz \
		| tar -xJ -C vendor --strip-components=1 shellcheck-v0.10.0/shellcheck
	@chmod +x vendor/shellcheck

vendor:
	@mkdir -p vendor
	$(SKOPEO) --policy $(POLICY) copy --override-os linux --override-arch amd64 \
		docker://docker.io/library/nginx:alpine \
		docker-archive:vendor/nginx-alpine.tar:nginx:alpine
	$(SKOPEO) --policy $(POLICY) copy --override-os linux --override-arch amd64 \
		docker://docker.io/library/busybox:latest \
		docker-archive:vendor/busybox.tar:busybox:latest
	@printf 'Generated by make vendor on %s\n\n' "$$(date -Is)" > vendor/IMAGES.txt
	@printf '%-18s %s\n' "nginx:alpine" "$$($(SKOPEO) --policy $(POLICY) inspect --format '{{.Digest}}' docker-archive:vendor/nginx-alpine.tar:nginx:alpine)" >> vendor/IMAGES.txt
	@printf '%-18s %s\n' "busybox:latest" "$$($(SKOPEO) --policy $(POLICY) inspect --format '{{.Digest}}' docker-archive:vendor/busybox.tar:busybox:latest)" >> vendor/IMAGES.txt
	@cat vendor/IMAGES.txt

run:
	sudo bash XX_RUN_FROM_SNAPSHOT.sh

verify:
	@./verify.sh

teardown:
	@./99_teardown.sh
