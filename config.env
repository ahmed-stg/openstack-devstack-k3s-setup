# Path to the Ubuntu 24.04 cloud image (download if not present)
export BASE_IMAGE="images/noble-server-cloudimg-amd64.img"

# VM configuration
export VM_NAME="BaseDevStack"
export VM_RAM=16284  # MB
export VM_VCPUS=6
export DISK_SIZE="80G"

# Pool path for VM disks (ensure directory exists)
export POOL_PATH="/var/lib/libvirt/images"

# SSH key path (default is fine if using standard location)
export SSH_KEY_PUB="$HOME/.ssh/id_ed25519.pub"

# K3s files (download and place in project directory)
export K3S_BINARY="images/k3s"
export K3S_AIRGAP_IMAGES="images/k3s-airgap-images-amd64.tar"

# Optional: Number of worker nodes (default 1)
export WORKER_COUNT=1